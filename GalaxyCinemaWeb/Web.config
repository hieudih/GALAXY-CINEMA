<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
	  <add name="GalaxyCinema"
	   connectionString="Data Source=DESKTOP-SBIJ9KU;Initial Catalog=GalaxyCinema;Integrated Security=True;TrustServerCertificate=True"
	   providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="QuanLy.TenDangNhap" value="quanly" />
    <add key="QuanLy.MatKhau" value="quanly@123" />
    <add key="SoatVe.TenDangNhap" value="soatve" />
    <add key="SoatVe.MatKhau" value="soatve@123" />
